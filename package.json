{
  "name": "dsh-doubao-web",
  "version": "0.4.0",
  "description": "DSH 插件 · 豆包代替思考：每条指令都先抛给网页版豆包，再把豆包的回答原样带回；设置页自带独立面板",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "doubao",
    "豆包",
    "web-search",
    "browser",
    "cdp"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "impl.mjs",
    "settings.mjs",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/clean.test.mjs && node test/settings.test.mjs && node test/client.test.mjs"
  },
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
